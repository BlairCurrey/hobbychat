{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hobbychat",
  "main": "packages/cloudflare/src/worker.ts",
  "compatibility_date": "2026-10-01",

  // Builds the browser client (/client.js) and the admin UI before dev and deploy.
  "build": {
    "command": "node packages/cloudflare/scripts/build-assets.mjs",
    "watch_dir": ["packages/client/src", "packages/admin/src"]
  },
  "assets": {
    "directory": "packages/cloudflare/dist/assets",
    "binding": "ASSETS",
    // Admin pages are checked for auth, and the demo page only exists in dev.
    "run_worker_first": ["/admin", "/admin/*", "/demo", "/demo/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hobbychat",
      "migrations_dir": "packages/cloudflare/migrations"
    }
  ],

  // Posts per IP per minute, across all rooms and connections, on top of each app's
  // per-connection rateLimit. Leaves room for a few people sharing one IP (a home,
  // a school) while keeping one machine well under the free plan's daily D1 writes.
  // namespace_id just has to be unique among rate limiters in your Cloudflare account.
  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "41707", "simple": { "limit": 20, "period": 60 } }],

  // Daily cleanup: message retention, per-room caps, expired bans.
  "triggers": { "crons": ["17 3 * * *"] },

  // ALLOWED_ORIGINS, ACCESS_TEAM_DOMAIN and ACCESS_AUD are set in the Cloudflare
  // dashboard (Worker > Settings > Variables and Secrets), not here, so that
  // redeploys keep them. See docs/configuration.md and docs/admin.md.
  "keep_vars": true,

  "observability": { "enabled": true }
}
